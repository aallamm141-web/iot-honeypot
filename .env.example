# ==============================================================================
# IOT DECEPTION HONEYPOT NETWORK — ENVIRONMENT CONFIGURATION TEMPLATE
# انسخ الملف ده باسم .env واملأ القيم الحقيقية بتاعتك:
#   cp .env.example .env && chmod 600 .env
# قواعد: سطور KEY=value بس، من غير "export"، ومن غير تعليق جنب القيمة.
# ==============================================================================

# ==============================
# Project Root
# ==============================
PROJECT_ROOT=/home/youruser/honeypot

# ==============================
# Telegram Alerting
# ==============================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================
# Threat Intel / Sandbox APIs
# ==============================
ABUSEIPDB_API_KEY=
TRIAGE_API_KEY=

# ==============================
# Elasticsearch & Kibana
# ==============================
ELASTIC_HOST=https://localhost:9200
ELASTIC_USER=elastic
ELASTIC_PASSWORD=
# false لأن الاتصال على localhost بشهادة self-signed (مش إعداد إنتاج)
ES_VERIFY_SSL=false

# ==============================
# SOC Proxy (خليه على localhost)
# ==============================
SOC_PROXY_HOST=127.0.0.1
SOC_PROXY_PORT=5000
SOC_PROXY_ALLOWED_ORIGIN=http://localhost:8080

# ==============================
# Honeypot Infrastructure Details
# ==============================
HONEYPOT_IP=
HONEYPOT_NAME="IoT Security Gateway Hub"

# ==============================
# Canary Tokens
# ==============================
CANARY_TOKEN_URL=
CANARY_TOKEN_EMAIL=

# ==============================
# Cowrie Fake Credentials (decoy creds shown to attacker, not real)
# ==============================
COWRIE_FAKE_USER=root
COWRIE_FAKE_PASSWORD=

# ==============================
# Log Paths (استثناء - خارج PROJECT_ROOT)
# ==============================
COWRIE_LOG_PATH=/var/lib/docker/volumes/docker_cowrie-var/_data/log/cowrie/cowrie.json

# ==============================
# Detection & Threshold Settings
# ==============================
LOOP_INTERVAL=10
BRUTE_FORCE_MIN=10
SCADA_ATTACK_MIN=20

# Excluded IPs (Loopback, Any, and attacker/test machine IP — عدّل حسب بيئتك)
EXCLUDED_IPS=127.0.0.1,0.0.0.0
